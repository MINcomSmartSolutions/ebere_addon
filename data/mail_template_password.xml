<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="mail_template_partner_password" model="mail.template">
        <field name="name">EBeRE App: Zugangsdaten</field>
        <field name="model_id" ref="base.model_res_partner"/>
        <field name="subject">Ihre Zugangsdaten für die EBeRE App</field>
        <field name="email_from">ebere@mincom-smart-solutions.com</field>
        <field name="email_to">{{ object.email }}</field>
        <field name="lang">{{ object.lang or 'de_DE' }}</field>
        <field name="auto_delete" eval="True"/>
        <field name="body_html" type="html">
            <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="width:100%;border-collapse:collapse;">
                <tr>
                    <td align="left" style="padding:0;">
                        <table role="presentation" width="600" cellpadding="0" cellspacing="0" border="0" style="width:100%;max-width:600px;border-collapse:collapse;">
                            <tr>
                                <td style="padding:0;font-family:Arial,Helvetica,sans-serif;font-size:16px;line-height:24px;color:#1f2937;">
                                    <p style="margin:0 0 16px;">Guten Tag <t t-out="object.name or ''">Kunde</t>,</p>
                                    <p style="margin:0 0 16px;">für Ihren Zugang zur EBeRE App wurden folgende Zugangsdaten erstellt:</p>
                                    <table role="presentation" width="460" cellpadding="0" cellspacing="0" border="0" style="width:100%;max-width:460px;border-collapse:separate;border-spacing:0;margin:0 0 20px;background-color:#f3f4f6;border:1px solid #e5e7eb;border-radius:8px;">
                                        <tr>
                                            <td width="90" valign="top" style="padding:14px 16px 6px;font-family:Arial,Helvetica,sans-serif;font-size:16px;line-height:24px;font-weight:bold;color:#1f2937;">E-Mail</td>
                                            <td valign="top" style="padding:14px 16px 6px;font-family:Arial,Helvetica,sans-serif;font-size:16px;line-height:24px;color:#1f2937;word-break:break-all;"><t t-out="object.email or ''">email</t></td>
                                        </tr>
                                        <tr>
                                            <td width="90" valign="top" style="padding:6px 16px 14px;font-family:Arial,Helvetica,sans-serif;font-size:16px;line-height:24px;font-weight:bold;color:#1f2937;">Passwort</td>
                                            <td valign="top" style="padding:6px 16px 14px;font-family:Consolas,Menlo,'Courier New',monospace;font-size:16px;line-height:24px;color:#1f2937;word-break:break-all;"><t t-out="ctx.get('password') or ''">password</t></td>
                                        </tr>
                                    </table>
                                    <p style="margin:0 0 16px;">Wir empfehlen Ihnen, nach der Erstanmeldung mit den in dieser Nachricht genannten Zugangsdaten Ihr Passwort zu ändern. Sie werden dabei auch direkt in der App hingewiesen.</p>
                                    <p style="margin:0 0 20px;">Unter folgendem Link finden Sie zudem ein kurzes Erklärvideo, das Ihnen in ca. 2,5 Minuten alle wichtigen Funktionen vorstellt: <a href="https://ebere-projekt.de/data/videos/EBeRELightApp_720p.mp4" target="_blank" style="color:#1d4ed8;text-decoration:underline;">EBeRE App</a></p>
                                    <table role="presentation" width="460" cellpadding="0" cellspacing="0" border="0" style="width:100%;max-width:460px;border-collapse:separate;border-spacing:0;margin:0 0 24px;background-color:#f8fafc;border:1px solid #e5e7eb;border-radius:8px;">
                                        <tr>
                                            <td colspan="2" align="center" style="padding:20px 20px 12px;font-family:Arial,Helvetica,sans-serif;font-size:17px;line-height:24px;font-weight:bold;color:#111827;">EBeRE App herunterladen</td>
                                        </tr>
                                        <tr>
                                            <td width="50%" align="center" valign="middle" style="width:50%;padding:8px 8px 20px;">
                                                <a href="https://play.google.com/store/apps/details?id=com.mincomsmartsolutions.incentivization" target="_blank" style="text-decoration:none;color:#1d4ed8;font-family:Arial,Helvetica,sans-serif;font-size:14px;">
                                                    <img src="/ebere_addon/static/src/img/google-play-badge.png" alt="Bei Google Play herunterladen" width="135" height="52" border="0" style="display:block;width:135px;height:52px;border:0;outline:none;text-decoration:none;"/>
                                                </a>
                                            </td>
                                            <td width="50%" align="center" valign="middle" style="width:50%;padding:8px 8px 20px;">
                                                <a href="https://apps.apple.com/de/app/eberendite/id6464049545" target="_blank" style="text-decoration:none;color:#1d4ed8;font-family:Arial,Helvetica,sans-serif;font-size:14px;">
                                                    <img src="/ebere_addon/static/src/img/app-store-badge.png" alt="Im App Store laden" width="135" height="45" border="0" style="display:block;width:135px;height:45px;border:0;outline:none;text-decoration:none;"/>
                                                </a>
                                            </td>
                                        </tr>
                                    </table>
                                    <p style="margin:0;">
                                        Mit freundlichen Grüßen<br/>
                                        Ihr EBeRE Projekt-Team
                                    </p>
                                </td>
                            </tr>
                        </table>
                    </td>
                </tr>
            </table>
        </field>
    </record>
</odoo>

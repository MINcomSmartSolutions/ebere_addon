<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="mail_template_partner_password" model="mail.template">
        <field name="name">EBERE App: Zugangsdaten</field>
        <field name="model_id" ref="base.model_res_partner"/>
        <field name="subject">Ihre Zugangsdaten für die EBERE App</field>
        <field name="email_from">{{ (user.company_id.email or user.email) }}</field>
        <field name="email_to">{{ object.email }}</field>
        <field name="lang">{{ object.lang or 'de_DE' }}</field>
        <field name="auto_delete" eval="True"/>
        <field name="body_html" type="html">
            <div style="margin:0;padding:0;font-size:16px;line-height:24px;font-family:Arial,Helvetica,sans-serif;color:#1f2937;">
                <p style="margin:0 0 16px;">Guten Tag <t t-out="object.name or ''">Kunde</t>,</p>
                <p style="margin:0 0 16px;">für Ihren Zugang zur EBERE App wurden folgende Zugangsdaten erstellt:</p>
                <table role="presentation" style="width:100%;max-width:460px;border-collapse:separate;border-spacing:0;margin:0 0 20px;background-color:#f3f4f6;border:1px solid #e5e7eb;border-radius:8px;">
                    <tr>
                        <td style="padding:14px 16px 6px;font-weight:bold;">E-Mail</td>
                        <td style="padding:14px 16px 6px;"><t t-out="object.email or ''">email</t></td>
                    </tr>
                    <tr>
                        <td style="padding:6px 16px 14px;font-weight:bold;">Passwort</td>
                        <td style="padding:6px 16px 14px;"><t t-out="ctx.get('password') or ''">password</t></td>
                    </tr>
                </table>
                <p style="margin:0 0 20px;">Bitte ändern Sie Ihr Passwort nach der ersten Anmeldung aus Sicherheitsgründen.</p>
                <table role="presentation" style="width:100%;max-width:460px;border-collapse:separate;border-spacing:0;margin:0 0 24px;background-color:#f8fafc;border:1px solid #e5e7eb;border-radius:8px;">
                    <tr>
                        <td colspan="2" style="padding:20px 20px 12px;text-align:center;">
                            <p style="margin:0 0 4px;font-size:17px;line-height:24px;font-weight:bold;color:#111827;">EBERE App herunterladen</p>
                        </td>
                    </tr>
                    <tr>
                        <td style="width:50%;padding:8px 8px 20px;text-align:center;">
                            <a href="https://play.google.com/store/apps/details?id=com.mincomsmartsolutions.incentivization" style="display:inline-block;border:0;text-decoration:none;">
                                <img src="/ebere_addon/static/src/img/google-play-badge.png" alt="Bei Google Play herunterladen" width="135" height="52" style="display:block;width:135px;height:52px;border:0;"/>
                            </a>
                        </td>
                        <td style="width:50%;padding:8px 8px 20px;text-align:center;">
                            <a href="https://apps.apple.com/de/app/eberendite/id6464049545" style="display:inline-block;border:0;text-decoration:none;">
                                <img src="/ebere_addon/static/src/img/app-store-badge.png" alt="Im App Store laden" width="135" height="45" style="display:block;width:135px;height:45px;border:0;"/>
                            </a>
                        </td>
                    </tr>
                </table>
                <p style="margin:0;">
                    Mit freundlichen Grüßen,<br/>
                    <t t-out="user.company_id.name or ''">Ihr Team</t>
                </p>
            </div>
        </field>
    </record>
</odoo>
